# Copy this file to .env and fill in your key. Never commit .env.

# Meta Model API key from dev.meta.ai (the account that received the $150 hackathon credits).
MODEL_API_KEY=

# Text model. muse-spark-1.3-contributor costs far less, but Meta may train on your prompts:
# only switch to it when every prompt is made-up test data.
TEXT_MODEL=muse-spark-1.3

# Local spending cap in USD. It is an estimate from token counts; the Billing page is the real number.
SPEND_CAP_USD=100

PORT=4310
